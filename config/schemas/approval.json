{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "local",
            "dev",
            "test",
            "multidev",
            "production"
          ]
        },
        "authorized": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "authorized"
      ],
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "uri"
      ],
      "additionalProperties": false
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "approvedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recoveryDigest": {
      "type": "string",
      "minLength": 1
    },
    "approvedDestructive": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "planId",
    "environment",
    "site",
    "approver",
    "approvedAt",
    "steps",
    "recoveryDigest"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
