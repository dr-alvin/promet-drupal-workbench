{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "local",
            "dev",
            "test",
            "multidev",
            "production"
          ]
        },
        "authorized": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "authorized"
      ],
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "uri"
      ],
      "additionalProperties": false
    },
    "roots": {
      "type": "object",
      "properties": {
        "composer": {
          "type": "string",
          "minLength": 1
        },
        "drupal": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "string",
          "minLength": 1
        },
        "custom": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "wrapper": {
          "enum": [
            "ddev",
            "fin",
            "lando",
            "compose",
            "local"
          ]
        },
        "commands": {
          "type": "object",
          "properties": {
            "php": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "composer": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "drush": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "runtimeProfile": {
      "type": "string",
      "minLength": 1
    },
    "estimationProfile": {
      "type": "string",
      "minLength": 1
    },
    "estimation": {
      "type": [
        "object",
        "string"
      ]
    },
    "client": {
      "type": [
        "object",
        "string"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "logo": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      }
    },
    "containerPrefix": {
      "type": "string",
      "minLength": 1
    },
    "configOverrides": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "settingsOverrides": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identity": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "argv",
        "expected"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "recovery": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "procedure": {
          "type": "string",
          "minLength": 1
        },
        "verifiedAt": {
          "type": "string",
          "minLength": 1
        },
        "zeroCopy": {
          "type": "boolean"
        },
        "sourcePath": {
          "type": "string"
        },
        "originalBranch": {
          "type": "string"
        },
        "upgradeBranch": {
          "type": "string"
        },
        "databaseBackup": {
          "type": "string"
        },
        "databaseHash": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "database",
        "files",
        "owner",
        "procedure",
        "verifiedAt"
      ],
      "additionalProperties": false
    },
    "requirementsEvidence": {
      "type": "string",
      "minLength": 1
    },
    "baselineEvidence": {
      "type": "string",
      "minLength": 1
    },
    "proposedChanges": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "stage": {
            "enum": [
              "A-baseline",
              "B-readiness",
              "C-remediation",
              "D-composer",
              "E-deployment",
              "F-verification"
            ]
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "mutates": {
            "type": "boolean"
          },
          "preparation": {
            "type": "boolean"
          },
          "destructive": {
            "type": "boolean"
          },
          "reviewedRemovalDigest": {
            "type": "string",
            "minLength": 1
          },
          "newWorkaround": {
            "type": "boolean"
          },
          "importsConfig": {
            "type": "boolean"
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "argv": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 1
                },
                "stdoutEquals": {
                  "type": "string"
                }
              },
              "required": [
                "argv"
              ],
              "additionalProperties": false
            }
          },
          "postconditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "argv": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 1
                },
                "stdoutEquals": {
                  "type": "string"
                }
              },
              "required": [
                "argv"
              ],
              "additionalProperties": false
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeout": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "stage",
          "argv",
          "cwd",
          "mutates",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "command",
              "upgrade_status"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "timeout": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "argv",
          "cwd",
          "kind",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "configComparison": {
      "type": "object",
      "properties": {
        "before": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "before",
        "after"
      ],
      "additionalProperties": false
    },
    "estimates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "lowHours": {
            "type": "number",
            "minimum": 0
          },
          "highHours": {
            "type": "number",
            "minimum": 0
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "phase",
          "owner",
          "lowHours",
          "highHours",
          "basis"
        ],
        "additionalProperties": false
      }
    },
    "visual": {
      "type": "object",
      "properties": {
        "config": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "config",
        "output"
      ],
      "additionalProperties": false
    },
    "deliveryBudget": {
      "type": "object",
      "properties": {
        "targetHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "checkpointHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "projectDecision": {
          "type": "string",
          "minLength": 1
        },
        "reportedHumanHours": {
          "type": "number",
          "minimum": 0
        },
        "unattendedRuntimeHours": {
          "type": "number",
          "minimum": 0
        },
        "externalWaitingHours": {
          "type": "number",
          "minimum": 0
        },
        "businessUatHours": {
          "type": "number",
          "minimum": 0
        },
        "completedWork": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolvedBlockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forecast": {
          "type": "object",
          "properties": {
            "scope": {
              "enum": [
                "total",
                "remaining"
              ]
            },
            "lowHours": {
              "type": "number",
              "minimum": 0
            },
            "highHours": {
              "type": "number",
              "minimum": 0
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "lowHours",
            "highHours",
            "basis"
          ],
          "additionalProperties": false
        },
        "checkpointReview": {
          "type": "object",
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "reviewedAt": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "reviewer",
            "reviewedAt",
            "evidence"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "compatibilityCoverage": {
      "type": "object",
      "properties": {
        "requiredCheckIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "scopeEvidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "requiredCheckIds",
        "target",
        "scopeEvidence"
      ],
      "additionalProperties": false
    },
    "zeroCopy": {
      "type": "boolean"
    },
    "sourcePath": {
      "type": "string"
    },
    "originalBranch": {
      "type": "string"
    },
    "upgradeBranch": {
      "type": "string"
    },
    "databaseBackup": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "repository",
    "environment"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
