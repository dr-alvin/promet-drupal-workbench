{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "prepared",
        "running",
        "findings",
        "tool_failure",
        "blocked",
        "unknown"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "findings",
              "visual_mismatch",
              "functional_failure",
              "tool_failure",
              "blocked",
              "skipped",
              "unknown"
            ]
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schemaVersion",
    "status"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
