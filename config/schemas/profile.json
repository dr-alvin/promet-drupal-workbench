{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "destination": {
      "type": "string",
      "minLength": 1
    },
    "php": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "supportedPattern": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "supportedPattern"
      ],
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "supportedPattern": {
          "type": "string",
          "minLength": 1
        },
        "supportedTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "version",
        "supportedPattern"
      ],
      "additionalProperties": false
    },
    "images": {
      "type": "object",
      "properties": {
        "cli": {
          "type": "string",
          "minLength": 1
        },
        "db": {
          "type": "string",
          "minLength": 1
        },
        "web": {
          "type": "string",
          "minLength": 1
        },
        "memcached": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "cli",
        "db",
        "web"
      ],
      "additionalProperties": false
    },
    "cliLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "destination",
    "php",
    "database",
    "images"
  ],
  "additionalProperties": false
}
